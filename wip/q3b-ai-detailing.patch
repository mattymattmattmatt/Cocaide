+    const c = composed.get(a.id);
+    return c && !c.problem && c.along && c.value !== undefined && a.tolerance?.kind !== "reference" && a.tolerance?.kind !== "basic" ? [{ id: a.id, from: a.from!, to: a.to!, along: c.along, view: a.view, value: c.value }] : [];
