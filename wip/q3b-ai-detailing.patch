+import { readFileSync, writeFileSync } from "node:fs";
+import { LocalKernel } from "../src/ask/kernel";
+import { apply, type Command, type RawDocument } from "../src/doc/commands";
+import { validateDocument } from "../src/doc/validate";
+import { composeDrawing } from "../src/drafting/compose";
+import { DEFAULT_VIEWS, planDrawing } from "../src/drafting/plan";
+import { viewSpecs } from "../src/drafting/specs";
+import { getOC, loadOC } from "../src/kernel";
+import { sheetRaster } from "../src/ask/detail/raster";
+await loadOC();
+const kernel = new LocalKernel(getOC);
+let doc: RawDocument = JSON.parse(readFileSync(`examples/flange.cocaide.json`, "utf8"));
+const c = await kernel.check(doc);
+const run = (cmd: Command) => {
+  const r = apply(doc, cmd);
+  if (!r.ok) throw new Error(cmd.type + ": " + r.error);
+  doc = r.doc;
+};
+run({ type: "setDrawing", drawing: planDrawing(doc, c.measurements, await kernel.project(doc, DEFAULT_VIEWS), { date: "2026-11-04" }) });
+const v0 = validateDocument(doc);
+console.log(JSON.stringify(v0.drawing!.sheets[0].views));
+const cmds: Command[] = [
+  { type: "editAnnotation", id: "d6", patch: { tolerance: { kind: "fit", fit: "H7" } } },
+  { type: "setAnnotation", id: "datum_A", annotation: { type: "datum", view: "front", label: "A", on: "front:@bottom" } },
+  { type: "setAnnotation", id: "datum_B", annotation: { type: "datum", view: "top", label: "B", dimension: "d6" } },
+  { type: "setAnnotation", id: "g1", annotation: { type: "gdt", view: "top", dimension: "h5", rows: [{ characteristic: "position", diameter: true, tolerance: 0.1, material: "M", datums: [{ label: "A" }, { label: "B", modifier: "M" }] }] } },
+  { type: "setAnnotation", id: "g2", annotation: { type: "gdt", view: "top", dimension: "d6", rows: [{ characteristic: "perpendicularity", diameter: true, tolerance: 0.02, datums: [{ label: "A" }] }] } },
+  { type: "setAnnotation", id: "g3", annotation: { type: "gdt", view: "front", on: "front:@bottom", rows: [{ characteristic: "flatness", tolerance: 0.05 }] } },
+  { type: "setAnnotation", id: "s1", annotation: { type: "surface", general: true, symbol: "removal", values: ["Ra 6.3"] } },
+  { type: "setAnnotation", id: "s2", annotation: { type: "surface", view: "front", symbol: "removal", values: ["Ra 3.2"], on: "front:@bottom" } },
+] as Command[];
+for (const cmd of cmds) run(cmd);
+const v = validateDocument(doc);
+const composed = composeDrawing(doc, { measurements: c.measurements, geometry: await kernel.project(doc, viewSpecs(v.drawing!)) })!;
+const sheet = composed.sheets[0];
+for (const a of sheet.annotations) if (!a.type.startsWith("center")) console.log(a.id, a.type, JSON.stringify(a.text), a.problem ?? "", JSON.stringify(a.box));
+console.log(sheet.problems);
+import { listGeoRefs } from "../src/drafting/georef";
+for (const r of listGeoRefs(sheet, "front")) console.log(JSON.stringify(r));
+writeFileSync(`${process.argv[2]}/try.png`, (await sheetRaster(sheet)).png);
