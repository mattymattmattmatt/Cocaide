index 0000000..bc7451b
--- /dev/null
+++ b/src/ask/detail/notes.ts
@@ -0,0 +1,44 @@
+// The general notes a detailed drawing carries (Phase Q wave Q3B): what the
+// shop needs that no symbol on the views says. Numbered in the notes block.
+
+import type { RawDocument } from "../../doc/commands";
+import { partProperties } from "../../doc/properties";
+import { validateDocument } from "../../doc/validate";
+import type { Measurements } from "../../kernel/measure";
+import type { DetailPlan } from "./plan";
+
+const r2 = (x: number) => Math.round(x * 100) / 100;
+
+/** The notes, in order: material, tolerances, surface, edges, finish, the weld rules for a weldment, units. */
+export function notesFor(plan: DetailPlan, doc: RawDocument, m: Measurements | null): string[] {
+  const v = validateDocument(doc);
+  const props = partProperties(doc) as Record<string, unknown>;
+  void m;
+  // The part's own material (the measurements' "steel (default)" is no material).
+  const material = plan.intent.material ?? v.material?.name;
+  const finish = typeof props.finish === "string" && props.finish.trim() ? props.finish.trim() : null;
+  const tol = plan.options.generalTolerance;
+  const tolText = /^(ISO|EN|DIN)\b/.test(tol) ? tol : `AS TABULATED: ${tol}`;
+  const out: string[] = [];
+  if (material) out.push(`MATERIAL: ${material.toUpperCase()}.`);
+  out.push(`GENERAL TOLERANCES ${tolText}.`);
+  if (plan.intent.kind === "weldment") {
+    out.push("WELDS TO ISO 2553, QUALITY LEVEL C TO ISO 5817, PROCESS 135 (MAG).");
+    out.push("FILLET WELDS a3 ALL ROUND UNLESS OTHERWISE SHOWN.");
+    out.push("REMOVE SPATTER AND SLAG; DEBURR ALL CUT ENDS.");
+    out.push(finish ? `FINISH: ${finish.toUpperCase()}.` : "DEGREASE AND PAINT AFTER WELDING: PRIMER AND TOP COAT, COLOUR AS ORDERED.");
+    out.push("SURFACES AS FABRICATED UNLESS OTHERWISE SHOWN.");
+  } else {
+    if (plan.options.roughness) out.push(`SURFACE ROUGHNESS ${plan.options.roughness} UNLESS OTHERWISE SHOWN (ISO 21920-1).`);
+    out.push("REMOVE ALL BURRS; BREAK SHARP EDGES 0.2–0.5 × 45°.");
+    if (plan.intent.holes.some((h) => h.purpose === "tapped")) out.push("THREADS ISO 965-1, 6H.");
+    for (const f of v.features) {
+      const x = f.feature as unknown as { op?: string; radius?: unknown; distance?: unknown } | undefined;
+      if (x?.op === "fillet" && typeof x.radius === "number" && !out.some((l) => l.startsWith("FILLETS"))) out.push(`FILLETS R${r2(x.radius)} UNLESS OTHERWISE SHOWN.`);
+      if (x?.op === "chamfer" && typeof x.distance === "number" && !out.some((l) => l.startsWith("CHAMFERS"))) out.push(`CHAMFERS ${r2(x.distance)} × 45° UNLESS OTHERWISE SHOWN.`);
+    }
+    out.push(finish ? `FINISH: ${finish.toUpperCase()}.` : /alumin/i.test(material ?? "") ? "FINISH: CLEAR ANODISE." : /stainless/i.test(material ?? "") ? "FINISH: PASSIVATE." : "FINISH: ZINC PLATE (ISO 2081), OR AS ORDERED.");
+  }
+  out.push("DIMENSIONS IN MILLIMETRES. DO NOT SCALE.");
+  return out;
+}
diff --git a/src/ask/detail/packet.ts b/src/ask/detail/packet.ts
new file mode 100644
index 0000000..88a3d30
--- /dev/null
+++ b/src/ask/detail/packet.ts
@@ -0,0 +1,154 @@
+// The drawing packet v2 (Phase Q wave Q3B): what a drawing ask is told about
+// the drawing and the part behind it, compactly. Per view: its kind, scale
+// and what it shows, and every GeoRef it offers as one short line ("top:
+// ebolt_hole/c0 circle Ø6.6 bolt_hole (counterbored M6)"); the part's
+// features, parameters and design intent; every annotation with what it
+// reads and its effective tolerance (toleranceOf); the general tolerance;
+// the critic's findings. Its size is measured (about four characters a
+// token) and kept within a budget: long GeoRef lists are cut per view (the
+// rest summarised by kind) until the whole sheet fits. A small local model
+// gets the compact budget.
+
+import type { RawDocument } from "../../doc/commands";
+import { allAnnotations } from "../../doc/drawing";
+import { documentParameters } from "../../doc/parameters";
+import { validateDocument } from "../../doc/validate";
+import { listGeoRefs } from "../../drafting/georef";
+import { toleranceOf } from "../../drafting/tolerance";
+import { findingsOf } from "./auto";
+import type { DetailState } from "./execute";
+import type { DesignIntent } from "./intent";
+
+/** Tokens a packet may take: a whole sheet for Claude, and for a small local model. */
+export const PACKET_BUDGET = { full: 12000, compact: 3500 } as const;
+
+/** About how many tokens a JSON value takes (four characters a token, as the API counts English and JSON roughly). */
+export function packetTokens(x: unknown): number {
+  return Math.ceil(JSON.stringify(x).length / 4);
+}
+
+export interface DrawingContext {
+  design: Record<string, unknown>;
+  model: { features: string[]; parameters?: Record<string, number> };
+  standard: string;
+  generalTolerance: string | null;
+  views: { id: string; kind: string; look: string; scale: string; label?: string; parent?: string; geoRefs: string[]; more?: string }[];
+  annotations: string[];
+  findings: string[];
+  /** Its size, tokens, and what was cut to keep it in budget. */
+  tokens: number;
+  trimmed?: string;
+}
+
+const r2 = (x: number) => Math.round(x * 100) / 100;
+
+/** A feature in a line: "hole_1 hole Ø6.6 thru (clearance M6)". */
+function featureLine(f: Record<string, unknown>, intent: DesignIntent): string {
+  const id = String(f.id);
+  const op = String(f.op);
+  const bits: string[] = [];
+  for (const k of ["size", "diameter", "distance", "depth", "radius", "count", "profile", "from", "to", "type", "node"]) {
+    const v = f[k];
+    if (typeof v === "number" || typeof v === "string") bits.push(`${k} ${typeof v === "number" ? r2(v) : v}`);
+  }
+  const h = intent.holes.find((x) => x.makers.includes(id));
+  const b = intent.bores.find((x) => x.feature === id);
+  const why = h ? ` (${h.purpose}${h.fit ? ` ${h.pair ?? h.fit}` : ""}${h.size ? ` ${h.size}` : ""})` : b ? ` (bore Ø${b.diameter} ${b.pair})` : "";
+  return `${id} ${op}${bits.length ? ` ${bits.join(", ")}` : ""}${why}`;
+}
+
+/** The context for a drawing ask, within the budget; `view` keeps to one view. */
+export function drawingContext(state: DetailState, intent: DesignIntent, opts: { compact?: boolean; view?: string; findings?: boolean } = {}): DrawingContext | null {
+  const { sheet, drawing } = state;
+  if (!sheet || !drawing) return null;
+  const doc: RawDocument = state.doc;
+  const v = validateDocument(doc);
+  const budget = opts.compact ? PACKET_BUDGET.compact : PACKET_BUDGET.full;
+  const params = documentParameters(doc) as Record<string, unknown>;
+  const numbers = Object.fromEntries(Object.entries(params).filter(([, x]) => typeof x === "number")) as Record<string, number>;
+  const design = {
+    kind: intent.kind,
+    summary: intent.summary,
+    holes: intent.holes.map((h) => `${h.features.join("+")}: ${h.count}× Ø${h.diameter} ${h.purpose}${h.size ? ` ${h.size}` : ""}${h.pattern !== "single" ? `, ${h.pattern} pattern` : ""}${h.fit ? `, ${h.fit}${h.pair && h.pair !== h.fit ? ` (fit ${h.pair})` : ""}` : ""} — ${h.why}`),
+    bores: intent.bores.map((b) => `${b.feature}: bore Ø${b.diameter} ${b.purpose}, ${b.fit} (fit ${b.pair}) — ${b.why}`),
+    ...(intent.kind === "weldment" ? { joints: intent.joints.map((j) => `${j.id}: ${j.type} at ${j.node} (${j.members.join(", ")})`), welds: intent.welds } : {}),
+  };
+  const model = { features: v.features.flatMap((f) => (f.feature ? [featureLine(f.feature as unknown as Record<string, unknown>, intent)] : [])), ...(Object.keys(numbers).length ? { parameters: numbers } : {}) };
+  const composed = new Map(sheet.annotations.map((a) => [a.id, a]));
+  const annotations = allAnnotations(drawing)
+    .filter((a) => !opts.view || ("view" in a && a.view === opts.view))
+    .filter((a) => a.type !== "centerMark" && a.type !== "centerline")
+    .map((a) => {
+      const c = composed.get(a.id);
+      const where = "view" in a && a.view ? ` in ${a.view}` : "";
+      if (c?.problem) return `${a.id} ${a.type}${where}: NOT DRAWN (${c.problem})`;
+      let tol = "";
+      if (a.type === "dimension" && c?.value !== undefined) {
+        const t = toleranceOf({ value: c.value, kind: a.kind, tolerance: a.tolerance, places: a.precision }, drawing);
+        tol = ` [${t.source}: ${t.text}]`;
+      }
+      const at = a.type === "dimension" ? ` ${[a.from, a.to].filter(Boolean).join("→") || (a.refs ?? []).join(",") || a.member || ""}` : a.type === "hole" ? ` ${a.hole}` : a.type === "gdt" ? ` ${a.dimension ? `on ${a.dimension}` : a.on ?? ""}` : a.type === "datum" ? ` ${a.on ?? a.dimension ?? ""}` : "";
+      return `${a.id} ${a.type}${where}${at}: "${(c?.text ?? "").replace(/\n/g, " / ")}"${tol}`;
+    });
+  const views = sheet.views.filter((cv) => !opts.view || cv.id === opts.view || cv.id === sheet.views.find((x) => x.id === opts.view)?.parent);
+  const refsOf = new Map(
+    views.map((cv) => [
+      cv.id,
+      listGeoRefs(sheet, cv.id).map((r) => {
+        const h = r.feature ? intent.holes.find((x) => x.makers.includes(r.feature!)) : undefined;
+        const size = r.radius !== undefined ? ` Ø${r2(2 * r.radius)}` : r.length !== undefined ? ` L${r2(r.length)}` : "";
+        return { visible: r.visible, line: `${r.ref} ${r.what}${size}${r.feature ? ` ${r.feature}${h ? ` (${h.purpose}${h.size ? ` ${h.size}` : ""})` : ""}` : ""}${r.visible ? "" : " hidden"}` };
+      }),
+    ]),
+  );
+  const findings = opts.findings === false ? [] : findingsOf(state).map((f) => `${f.severity}: ${f.message}`);
+  const build = (limit: number, annLimit: number): DrawingContext => {
+    const vs = views.map((cv) => {
+      const all = refsOf.get(cv.id) ?? [];
+      // Seen ones first: hidden lines are not dimensioned to.
+      const sorted = [...all.filter((r) => r.visible), ...all.filter((r) => !r.visible)];
+      const kept = sorted.slice(0, limit).map((r) => r.line);
+      const rest = sorted.slice(limit);
+      const kinds = new Map<string, number>();
+      for (const r of rest) {
+        const k = r.line.split(" ")[1];
+        kinds.set(k, (kinds.get(k) ?? 0) + 1);
+      }
+      return {
+        id: cv.id,
+        kind: cv.kind,
+        look: cv.look,
+        scale: cv.scaleText,
+        ...(cv.label ? { label: cv.label } : {}),
+        ...(cv.parent ? { parent: cv.parent } : {}),
+        geoRefs: kept,
+        ...(rest.length ? { more: `${rest.length} more (${[...kinds].map(([k, n]) => `${n} ${k}`).join(", ")}): geoRefs(view) lists them` } : {}),
+      };
+    });
+    const anns = annotations.slice(0, annLimit);
+    const out: DrawingContext = {
+      design,
+      model,
+      standard: drawing.standard ?? "ISO",
+      generalTolerance: drawing.generalTolerance ?? null,
+      views: vs,
+      annotations: annotations.length > annLimit ? [...anns, `… and ${annotations.length - annLimit} more`] : anns,
+      findings: findings.slice(0, opts.compact ? 8 : 20),
+      tokens: 0,
+    };
+    out.tokens = packetTokens(out);
+    return out;
+  };
+  // Shrink until it fits: GeoRefs per view first, then the annotations listed.
+  let limit = opts.compact ? 30 : 80;
+  let annLimit = opts.compact ? 40 : 200;
+  let out = build(limit, annLimit);
+  while (out.tokens > budget && (limit > 6 || annLimit > 10)) {
+    if (limit > 6) limit = Math.max(6, Math.floor(limit / 2));
+    else annLimit = Math.max(10, Math.floor(annLimit / 2));
+    out = build(limit, annLimit);
+    out.trimmed = `GeoRefs cut to ${limit} per view${annLimit < annotations.length ? `, annotations to ${annLimit}` : ""} to keep within ${budget} tokens`;
+    out.tokens = packetTokens(out);
+  }
+  return out;
+}
diff --git a/src/ask/detail/plan.ts b/src/ask/detail/plan.ts
new file mode 100644
index 0000000..cab9eaf
--- /dev/null
+++ b/src/ask/detail/plan.ts
@@ -0,0 +1,471 @@
+// The detailing plan (Phase Q wave Q3B): what "Fully detail this drawing"
+// will add, item by item, from the part's design intent and by rules only
+// (no model), so it is the same every time, works without a model (Auto-
+// detail, small local models, tests) and is where a model-driven detailing
+// starts. The user sees it as a card: each item ticked or not, with why, and
+// the standard and tolerance level to change before anything is drawn.
+//
+// The rules (each item's `why` says which one it follows):
+// - views: a new drawing gets the planned views (a section through hidden
+//   insides, a detail of small features); one with hidden insides and no
+//   section gets a section through the most holes;
+// - every feature sized and located once (the auto-dimension engine fills
+//   what a view lacks);
+// - a datum scheme: A the mounting face (the face the holes are drilled
+//   from's opposite, seen edge on), B and C the locating edges of a
+//   prismatic part (the left and bottom of the plan view), B the bore of a
+//   round one;
+// - fits by purpose: a bore or bearing seat H7 (the shaft k6), a dowel hole
+//   H7 (dowel m6), a guide H7/g6; clearance holes (ISO 273) stay plain sizes;
+// - position Ø0.1 Ⓜ to A|B|C (round: A|B) for every hole pattern or located
+//   hole, its locating dimensions made basic; flatness on A (0.05 up to
+//   100 mm, 0.1 up to 300, 0.2 beyond); perpendicularity Ø0.02 of a fitted
+//   bore to A;
+// - threads called out from the Hole Wizard (they are in the callouts);
+// - surface texture: Ra 3.2 on A, Ra 1.6 in fitted bores, a general Ra 6.3;
+//   a weldment is as fabricated;
+// - weld symbols from the weld table, or fillet a3 all round at each joint;
+// - the general tolerance (ISO 2768-mK; a weldment ISO 13920-BF), the notes
+//   (material, deburr and break edges, finish, units), the cut list with a
+//   balloon for every item, the title block's material and revision, and a
+//   revision row "A FIRST ISSUE".
+
+import type { RawDocument } from "../../doc/commands";
+import type { Annotation, Drawing, DrawingView, GdtRow, GeoRef, SurfaceAnnotation, Vec3, WeldAnnotation } from "../../doc/types";
+import { allAnnotations, parseGeoRef } from "../../doc/drawing";
+import { autoDimensionSheetView } from "../../drafting/autodim";
+import type { ComposedSheet, ComposedView } from "../../drafting/compose";
+import { parseGeneralTolerance } from "../../drafting/tolerance";
+import type { Measurements } from "../../kernel/measure";
+import { cutList } from "../../weldment/cutlist";
+import type { DesignIntent } from "./intent";
+
+export const PLAN_GROUPS = ["views", "dimensions", "datums", "fits", "gdt", "surface", "welds", "tolerance", "notes", "tables", "title"] as const;
+export type PlanGroup = (typeof PLAN_GROUPS)[number];
+
+export const PLAN_GROUP_LABELS: Record<PlanGroup, string> = {
+  views: "Views",
+  dimensions: "Sizes and locations",
+  datums: "Datums",
+  fits: "Fits and size tolerances",
+  gdt: "Geometric tolerances",
+  surface: "Surface texture",
+  welds: "Welds",
+  tolerance: "General tolerance",
+  notes: "Notes",
+  tables: "Tables and balloons",
+  title: "Title block and revision",
+};
+
+/** What the user may change on the card before it is drawn. */
+export interface DetailOptions {
+  standard: "ISO" | "ASME";
+  /** "ISO 2768-mK", "ISO 13920-BF", or an ASME block "X.X ±0.5, X.XX ±0.1, ANG ±0.5°". */
+  generalTolerance: string;
+  /** Position tolerance of hole patterns, mm (Ø zone). */
+  position: number;
+  /** The general surface texture ("Ra 6.3"); none for as-fabricated. */
+  roughness: string | null;
+}
+
+/** What one item does, as data (the executor turns it into commands on the drawing as it then is). */
+export type PlanAction =
+  | { do: "drawing"; drawing: Drawing }
+  | { do: "view"; id: string; view: DrawingView }
+  | { do: "fill"; view: string; annotations: Annotation[] }
+  | { do: "datum"; id: string; label: string; view: string; on?: GeoRef; dimension?: string }
+  | { do: "fit"; target: string; fit: string; make?: Annotation; replaces?: string }
+  | { do: "basic"; ids: string[] }
+  | { do: "gdt"; id: string; view: string; rows: GdtRow[]; on?: GeoRef; dimension?: string; under?: string }
+  | { do: "surface"; id: string; surface: Omit<SurfaceAnnotation, "id" | "type"> }
+  | { do: "weld"; id: string; weld: Omit<WeldAnnotation, "id" | "type"> }
+  | { do: "tolerance" }
+  | { do: "notes"; id: string }
+  | { do: "table"; id: string; annotation: Annotation }
+  | { do: "balloons"; annotations: Annotation[] }
+  | { do: "title"; patch: Record<string, string> }
+  | { do: "revision" };
+
+export interface PlanItem {
+  id: string;
+  group: PlanGroup;
+  /** "Datum A on the mounting face (bottom, in front)". */
+  label: string;
+  why: string;
+  on: boolean;
+  /** Items it builds on: it is left out when one of them is unticked. */
+  needs?: string[];
+  /** A view it belongs to (a "Detail this view" plan keeps these). */
+  view?: string;
+  action: PlanAction;
+}
+
+export interface DetailPlan {
+  /** The part as the plan reads it. */
+  intent: DesignIntent;
+  options: DetailOptions;
+  items: PlanItem[];
+  /** Only this view (a "Detail this view" ask). */
+  view?: string;
+}
+
+/** The plan's starting point: the drawing as composed (or as New drawing would make it) and what the part is. */
+export interface PlanInput {
+  doc: RawDocument;
+  /** The drawing the plan works on: the document's, or the planned one when it has none (then `fresh`). */
+  drawing: Drawing;
+  sheet: ComposedSheet;
+  measurements: Measurements | null;
+  intent: DesignIntent;
+  fresh: boolean;
+  /** Only this view. */
+  view?: string;
+  options?: Partial<DetailOptions>;
+  date?: string;
+}
+
+const dot = (a: Vec3, b: Vec3) => a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
+const r2 = (x: number) => Math.round(x * 100) / 100;
+
+/** The default options for a part: ISO, 2768-mK (a weldment 13920-BF), position Ø0.1, Ra 6.3 (a weldment none). */
+export function defaultOptions(intent: DesignIntent, drawing?: Drawing): DetailOptions {
+  const weld = intent.kind === "weldment";
+  const given = drawing?.generalTolerance && parseGeneralTolerance(drawing.generalTolerance) ? drawing.generalTolerance : undefined;
+  return { standard: drawing?.standard ?? "ISO", generalTolerance: given ?? (weld ? "ISO 13920-BF" : "ISO 2768-mK"), position: 0.1, roughness: weld ? null : "Ra 6.3" };
+}
+
+/** The general tolerances the card offers. */
+export function toleranceChoices(intent: DesignIntent): string[] {
+  if (intent.kind === "weldment") return ["ISO 13920-AE", "ISO 13920-BF", "ISO 13920-CG", "ISO 13920-DH"];
+  return ["ISO 2768-fH", "ISO 2768-mK", "ISO 2768-cL", "ISO 2768-vL", "X.X ±0.5, X.XX ±0.1, X.XXX ±0.05, ANG ±0.5°"];
+}
+
+/** Flatness of a mounting face by its size: 0.05 up to 100 mm, 0.1 up to 300 mm, 0.2 beyond. */
+export function flatnessFor(size: number): number {
+  return size <= 100 ? 0.05 : size <= 300 ? 0.1 : 0.2;
+}
+
+/** The square views of a sheet, and which side of each a model direction points to. */
+function sideOf(cv: ComposedView, dir: Vec3): "@bottom" | "@top" | "@left" | "@right" | null {
+  const u = dot(cv.frame.up, dir);
+  const r = dot(cv.frame.right, dir);
+  if (Math.abs(u) > 0.999) return u < 0 ? "@bottom" : "@top";
+  if (Math.abs(r) > 0.999) return r < 0 ? "@left" : "@right";
+  return null;
+}
+
+/** The plan by rules. */
+export function planDetail(input: PlanInput): DetailPlan {
+  const { drawing, sheet, intent, doc } = input;
+  const options = { ...defaultOptions(intent, input.fresh ? undefined : drawing), ...(input.options ?? {}) };
+  const items: PlanItem[] = [];
+  const add = (it: PlanItem) => {
+    // "Detail this view": only what goes in that view (the drawing-wide items are for the whole drawing).
+    if (!input.view || it.view === input.view) items.push(it);
+  };
+  const annotations = allAnnotations(drawing);
+  const used = new Set(annotations.map((a) => a.id));
+  const free = (base: string) => {
+    let id = base;
+    for (let n = 2; used.has(id); n++) id = `${base}_${n}`;
+    used.add(id);
+    return id;
+  };
+  const square = sheet.views.filter((v) => v.square && v.outline);
+  const weld = intent.kind === "weldment";
+
+  if (input.fresh) {
+    const names = drawing.sheets[0].views.map((v) => (v.kind === "section" ? `section ${v.label ?? ""}–${v.label ?? ""}` : v.kind === "detail" ? `detail ${v.label ?? ""}` : v.id)).join(", ");
+    items.push({ id: "drawing", group: "views", label: `New drawing: ${names}`, why: "the part has no drawing: its views (a section through hidden insides, a detail of small features), sizes, callouts and centre marks as New drawing plans them", on: true, action: { do: "drawing", drawing } });
+  } else if (!weld && !sheet.views.some((v) => v.kind === "section")) {
+    // Hidden insides and no section: cut one through the plan view's holes.
+    const section = sectionFor(sheet, drawing);
+    if (section) add({ id: "section", group: "views", label: `Section ${section.view.label}–${section.view.label} through ${section.through}`, why: "the part has hidden insides (bores, counterbores) that a section shows without dashed lines", on: true, view: section.view.parent, action: { do: "view", id: section.view.id, view: section.view } });
+  }
+  // Each view's missing sizes and locations (an existing drawing; a new one already has them).
+  if (!input.fresh && !weld) {
+    let n = 0;
+    for (const cv of square) {
+      if (cv.kind === "section" || cv.kind === "detail") continue;
+      const fill = autoDimensionSheetView(doc, sheet, cv.id, input.measurements, (p) => free(`${p}${++n}`));
+      const real = fill.filter((a) => a.type !== "centerMark" && a.type !== "centerline");
+      if (!real.length) continue;
+      add({ id: `fill_${cv.id}`, group: "dimensions", label: `${real.length} size${real.length === 1 ? "" : "s"} and location${real.length === 1 ? "" : "s"} missing in ${cv.id}`, why: "every feature sized and located once (the auto-dimension engine: overall sizes, hole positions from the datums, no duplicates)", on: true, view: cv.id, action: { do: "fill", view: cv.id, annotations: fill } });
+    }
+  }
+
+  // ---- datums
+  const existing = new Map(annotations.filter((a) => a.type === "datum").map((a) => [a.label, a]));
+  const datumItem = new Map<string, string>();
+  const datum = (label: string, view: string, at: { on?: GeoRef; dimension?: string }, what: string, why: string) => {
+    if (existing.has(label)) return;
+    const id = free(`datum_${label}`);
+    datumItem.set(label, `datum_${label}`);
+    add({ id: `datum_${label}`, group: "datums", label: `Datum ${label}: ${what}`, why, on: true, view, action: { do: "datum", id, label, view, ...at } });
+  };
+  const mount = intent.mounting;
+  const elevation = mount ? square.find((cv) => cv.kind !== "detail" && sideOf(cv, mount) !== null && (cv.kind === "section" || !sheet.views.some((x) => x.kind === "section" && x.parent === undefined))) : undefined;
+  const elev = mount ? (square.filter((cv) => cv.kind !== "detail" && sideOf(cv, mount)).sort((a, b) => (a.kind === "section" ? -1 : 0) - (b.kind === "section" ? -1 : 0) || (sideOf(a, mount) === "@bottom" ? -1 : 1) - (sideOf(b, mount) === "@bottom" ? -1 : 1))[0] ?? elevation) : undefined;
+  const plan = mount ? square.find((cv) => cv.kind !== "section" && cv.kind !== "detail" && Math.abs(dot(cv.frame.eye, mount)) > 0.999) : undefined;
+  const aSide = elev && mount ? sideOf(elev, mount) : null;
+  if (!weld && elev && aSide) datum("A", elev.id, { on: `${elev.id}:${aSide}` }, `the mounting face (${aSide.slice(1)} in ${elev.id})`, "primary: the face the part is bolted down on (the holes are drilled toward it)");
+
+  // A fitted bore's diameter dimension: the one the plan tolerances (and B hangs on, for a round part).
