+registerDrawingTool({
+  id: "annotation.balloon",
+  tab: "annotation",
+  group: "notes",
+  label: "Balloon",
+  icon: "balloon",
+  title: "A balloon with the item number from the cut list or BOM: click a member or body, then where it goes",
+  testId: "tool-annotation-balloon",
