+function rel(c: DrawingToolCtx, view: string, p: Vec2): Vec2 {
+  const cv = c.sheet?.views.find((v) => v.id === view);
+  const o = cv ? cv.centre : [0, 0];
+  return [Math.round((p[0] - o[0]) * 10) / 10 + 0, Math.round((p[1] - o[1]) * 10) / 10 + 0];
+}
