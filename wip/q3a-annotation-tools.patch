index 0000000..a5be461
--- /dev/null
+++ b/src/ui/drawing/tools/annotationKindsQ3.tsx
@@ -0,0 +1,413 @@
+// The annotation kinds' panels and handles of wave Q3A: the Dimension panel
+// (its value, driven by the model, overridden with a warning; text before,
+// after and below; n× and TYP; decimals; the tolerance with its fields and
+// the ISO 286 fit editor showing the limits live; dual units; arrows; basic,
+// reference, inspection; favourites), the hole callout's bore tolerance, and
+// the grips every kind gets from the engine's layout (its text, its knee, a
+// leader's bends, a cloud's corners) plus a dimension's arrowheads, which flip
+// the arrows when clicked.
+
+import { useState } from "react";
+import type { Annotation, DimensionAnnotation, Vec2 } from "../../../doc/types";
+import { dragGrip as engineDrag, type Grip as EngineGrip } from "../../../drafting/annotate";
+import type { ComposedSheet } from "../../../drafting/compose";
+import { TOLERANCE_KINDS, type Tolerance, type ToleranceKind } from "../../../drafting/tolerance";
+import { parseFit } from "../../../drafting/fits";
+import { annotationKind, annotationKinds, registerAnnotationKind, type Grip, type KindCtx, type KindPanelProps } from "./kinds";
+import { applyFavourite, classChoices, COMMON_FITS, favouriteFrom, fitSummary, loadFavourites, storeFavourites, BUILT_IN_FAVOURITES } from "./styles";
+import { Commit, numberOf, Row, Segmented, SymbolPalette } from "./ui";
+
+// ------------------------------------------------------------ grips from the engine's layout
+
+const gripId = (g: EngineGrip) => `${g.name}:${g.field}:${g.index ?? ""}`;
+const GRIP_WORDS: Record<string, string> = { text: "Drag the text", line: "Drag the dimension line nearer or further", knee: "Drag the text and its leader's knee", symbol: "Drag the symbol", frame: "Drag the frame", end: "Drag the end", vertex: "Drag the corner" };
+
+/** The annotation's grips as laid out: what the engine says can be dragged. */
+function engineGrips(a: Record<string, unknown>, ctx: KindCtx): Grip[] {
+  return (ctx.said?.grips ?? []).map((g) => ({ id: gripId(g), at: g.at, label: GRIP_WORDS[g.name] ?? "Drag it" }));
+}
+
+/** The patch a dragged engine grip makes: the annotation as the engine moves it (keys it drops come back as null). */
+function engineDragPatch(a: Record<string, unknown>, grip: Grip, delta: Vec2, ctx: KindCtx): Record<string, unknown> | null {
+  const g = (ctx.said?.grips ?? []).find((x) => gripId(x) === grip.id);
+  if (!g) return null;
+  const next = engineDrag(a as unknown as Annotation, g, [g.at[0] + delta[0], g.at[1] + delta[1]], ctx.sheet) as unknown as Record<string, unknown>;
+  const patch: Record<string, unknown> = { ...next };
+  for (const k of Object.keys(a)) if (!(k in next)) patch[k] = null;
+  delete patch.id;
+  return patch;
+}
+
+/** A linear dimension's arrowheads (the two ends of its line): a click flips the arrows inside or outside. */
+function arrowGrips(a: Record<string, unknown>, ctx: KindCtx): Grip[] {
+  const place = ctx.said?.place;
+  const cv = ctx.sheet.views.find((v) => v.id === a.view);
+  if (!place || place.pts.length !== 4 || !cv) return [];
+  return [2, 3].map((i) => ({ id: `arrow:${i}`, at: [cv.centre[0] + place.pts[i][0], cv.centre[1] + place.pts[i][1]] as Vec2, label: "Click: arrows inside or outside", click: true }));
+}
+
+const dimension = annotationKind("dimension")!;
+const oldGrips = dimension.grips;
+const oldDrag = dimension.dragGrip;
+
+registerAnnotationKind({
+  ...dimension,
+  grips: (a, ctx) => {
+    const text = engineGrips(a, ctx).filter((g) => !g.id.startsWith("line:"));
+    const line = (oldGrips?.(a, ctx) ?? []).map((g) => ({ ...g, id: "offset" }));
+    return [...line, ...text, ...arrowGrips(a, ctx)];
+  },
+  dragGrip: (a, grip, delta, ctx) => {
+    if (grip.id.startsWith("arrow:")) {
+      const now = (a.arrows as string | undefined) ?? "auto";
+      return { arrows: now === "outside" ? "inside" : "outside" };
+    }
+    if (grip.id === "offset") return oldDrag?.(a, grip, delta, ctx) ?? null;
+    return engineDragPatch(a, grip, delta, ctx);
+  },
+  panel: (p) => <DimensionPanel {...p} />,
+});
+
+// Every other kind: the engine's grips, unless it has its own.
+for (const k of annotationKinds()) {
+  if (k.type === "dimension" || k.type === "table" || k.type === "centerMark" || k.type === "centerline") continue;
+  const own = k.grips;
+  registerAnnotationKind({
+    ...k,
+    grips: (a, ctx) => {
+      const g = engineGrips(a, ctx);
+      const extra = k.type === "note" ? leaderGrips(a, ctx) : [];
+      return g.length ? [...g, ...extra] : [...(own?.(a, ctx) ?? []), ...extra];
+    },
+    dragGrip: (a, grip, delta, ctx) => {
+      if (grip.id.startsWith("leader:")) return dragLeader(a, grip, delta);
+      if (grip.id.includes(":")) return engineDragPatch(a, grip, delta, ctx);
+      return k.dragGrip?.(a, grip, delta, ctx) ?? null;
+    },
+  });
+}
+
+// ------------------------------------------------------------ a note's leaders
+
+type LeaderData = { to: string | Vec2; via?: Vec2[]; arrow?: string; spline?: boolean };
+
+/** A note's leaders' bends and free ends (sheet points; in a view, from its centre). */
+function leaderGrips(a: Record<string, unknown>, ctx: KindCtx): Grip[] {
+  const leaders = (a.leaders as LeaderData[] | undefined) ?? [];
+  const cv = typeof a.view === "string" ? ctx.sheet.views.find((v) => v.id === a.view) : undefined;
+  const o: Vec2 = cv ? cv.centre : [0, 0];
+  const out: Grip[] = [];
+  leaders.forEach((l, i) => {
+    (l.via ?? []).forEach((p, j) => out.push({ id: `leader:${i}:via:${j}`, at: [o[0] + p[0], o[1] + p[1]], label: "Drag the leader's bend" }));
+    if (Array.isArray(l.to)) out.push({ id: `leader:${i}:to`, at: [o[0] + l.to[0], o[1] + l.to[1]], label: "Drag the leader's end" });
+  });
+  return out;
+}
+
+function dragLeader(a: Record<string, unknown>, grip: Grip, delta: Vec2): Record<string, unknown> | null {
+  const [, i, what, j] = grip.id.split(":");
+  const leaders = [...((a.leaders as LeaderData[] | undefined) ?? [])].map((l) => ({ ...l }));
+  const l = leaders[Number(i)];
+  if (!l) return null;
+  const mv = (p: Vec2): Vec2 => [Math.round((p[0] + delta[0]) * 10) / 10, Math.round((p[1] + delta[1]) * 10) / 10];
+  if (what === "via" && l.via) l.via = l.via.map((p, k) => (k === Number(j) ? mv(p) : p));
+  else if (what === "to" && Array.isArray(l.to)) l.to = mv(l.to);
+  return { leaders };
+}
+
+// ------------------------------------------------------------ the tolerance editor
+
+const KIND_WORDS: Record<ToleranceKind, string> = {
+  symmetric: "± symmetric",
+  bilateral: "+/− deviations",
+  limit: "Limits (max over min)",
+  fit: "Fit (class only)",
+  fitWithTol: "Fit with deviations",
+  fitLimits: "Fit with limits",
+  basic: "Basic (boxed)",
+  reference: "Reference (in brackets)",
+  min: "MIN",
+  max: "MAX",
+};
+
+/** A tolerance: its kind, its numbers or its ISO 286 class with the limits it gives at this size. */
+export function ToleranceEditor({ value, size, symbol, onChange, prefix, angle }: { value: Tolerance | undefined; size: number | undefined; symbol: string; onChange(t: Tolerance | null): string | null; prefix: string; angle?: boolean }) {
+  const [error, setError] = useState("");
+  const set = (t: Tolerance | null) => setError(onChange(t) ?? "");
+  const kind = value?.kind;
+  const fit = value?.fit ? parseFit(value.fit) : null;
+  const holeClass = fit?.hole ? `${fit.hole.letter}${fit.hole.grade}` : "";
+  const shaftClass = fit?.shaft ? `${fit.shaft.letter}${fit.shaft.grade}` : "";
+  const isFit = kind === "fit" || kind === "fitWithTol" || kind === "fitLimits";
+  const setFit = (hole: string, shaft: string) => {
+    const code = hole && shaft ? `${hole}/${shaft}` : hole || shaft;
+    if (!code) return set(null);
+    set({ kind: isFit ? kind! : "fitWithTol", fit: code, ...(value?.precision !== undefined ? { precision: value.precision } : {}) });
+  };
+  const num = (k: "plus" | "minus", s: string) => {
+    const n = numberOf(s);
+    if (n !== undefined && !Number.isFinite(n)) return setError(`${k === "plus" ? "Plus" : "Minus"} must be a number (got "${s}")`);
+    set({ ...(value ?? { kind: "symmetric" }), [k]: n } as Tolerance);
+  };
+  const summary = size && value?.fit && isFit ? fitSummary(size, value.fit, symbol) : null;
+  const kinds = TOLERANCE_KINDS.filter((k) => !angle || !k.startsWith("fit"));
+  return (
+    <div className="tolerance-editor" data-testid={`${prefix}-tolerance`}>
+      <Row label="Tolerance">
+        <select
+          value={kind ?? ""}
+          onChange={(e) => {
+            const k = e.target.value as ToleranceKind | "";
+            if (!k) return set(null);
+            if (k === "symmetric") return set({ kind: k, plus: value?.plus && value.plus > 0 ? value.plus : 0.1 });
+            if (k === "bilateral" || k === "limit") return set({ kind: k, plus: value?.plus ?? 0.1, minus: value?.minus ?? 0 });
+            if (k === "fit" || k === "fitWithTol" || k === "fitLimits") return set({ kind: k, fit: value?.fit ?? (symbol === "Ø" ? "H7" : "H7") });
+            set({ kind: k });
+          }}
+          data-testid={`${prefix}-tol-kind`}
+        >
+          <option value="">none (the general tolerance)</option>
+          {kinds.map((k) => (
+            <option key={k} value={k}>
+              {KIND_WORDS[k]}
+            </option>
+          ))}
+        </select>
+      </Row>
+      {(kind === "symmetric" || kind === "bilateral" || kind === "limit") && (
+        <div className="tol-fields">
+          <Row label={kind === "symmetric" ? "±" : "Plus"}>
+            <Commit value={value?.plus !== undefined ? String(value.plus) : ""} onCommit={(s) => num("plus", s)} testId={`${prefix}-tol-plus`} numeric width={80} />
+          </Row>
+          {kind !== "symmetric" && (
+            <Row label="Minus" hint="How far under the size it may be (0: none under)">
+              <Commit value={value?.minus !== undefined ? String(value.minus) : ""} onCommit={(s) => num("minus", s)} testId={`${prefix}-tol-minus`} numeric width={80} />
+            </Row>
+          )}
+        </div>
+      )}
+      {isFit && (
+        <>
+          <div className="tol-fields">
+            <Row label="Hole" hint="ISO 286 hole class: its deviations at this size">
+              <select value={holeClass} onChange={(e) => setFit(e.target.value, shaftClass)} data-testid={`${prefix}-fit-hole`}>
+                <option value="">—</option>
+                {(size ? classChoices(size, "hole") : []).map((c) => (
+                  <option key={c.value} value={c.value}>
+                    {c.label}
+                  </option>
+                ))}
+                {holeClass && size && !classChoices(size, "hole").some((c) => c.value === holeClass) && <option value={holeClass}>{holeClass}</option>}
+              </select>
+            </Row>
+            <Row label="Shaft" hint="ISO 286 shaft class: its deviations at this size">
+              <select value={shaftClass} onChange={(e) => setFit(holeClass, e.target.value)} data-testid={`${prefix}-fit-shaft`}>
+                <option value="">—</option>
+                {(size ? classChoices(size, "shaft") : []).map((c) => (
+                  <option key={c.value} value={c.value}>
+                    {c.label}
+                  </option>
+                ))}
+                {shaftClass && size && !classChoices(size, "shaft").some((c) => c.value === shaftClass) && <option value={shaftClass}>{shaftClass}</option>}
+              </select>
+            </Row>
+          </div>
+          <div className="fit-chips" role="group" aria-label="Common fits">
+            {COMMON_FITS.map((f) => (
+              <button key={f} type="button" className={`chip${value?.fit === f ? " on" : ""}`} onClick={() => set({ kind: kind!, fit: f })} data-testid={`${prefix}-fit-${f.replace("/", "-")}`}>
+                {f}
+              </button>
+            ))}
+          </div>
+          {summary && (
+            <div className={`fit-summary ${summary.type ?? ""}`} data-testid={`${prefix}-fit-summary`}>
+              {summary.lines.map((l) => (
+                <div key={l}>{l}</div>
+              ))}
+            </div>
+          )}
+        </>
+      )}
+      {kind && kind !== "basic" && kind !== "reference" && kind !== "min" && kind !== "max" && kind !== "fit" && (
+        <Row label="Deviation decimals">
+          <select
+            value={value?.precision ?? ""}
+            onChange={(e) => {
+              const p = e.target.value === "" ? undefined : Number(e.target.value);
+              const next = { ...value! } as Tolerance;
+              if (p === undefined) delete next.precision;
+              else next.precision = p;
+              set(next);
+            }}
+            data-testid={`${prefix}-tol-precision`}
+          >
+            <option value="">as needed</option>
+            {[1, 2, 3, 4].map((n) => (
+              <option key={n} value={n}>
+                {n}
+              </option>
+            ))}
+          </select>
+        </Row>
+      )}
+      {error && (
+        <p className="field-error" role="alert">
+          {error}
+        </p>
+      )}
+    </div>
+  );
+}
+
+// ------------------------------------------------------------ the Dimension panel
+
+function DimensionPanel({ a, said, write, env }: KindPanelProps) {
+  const d = a as unknown as DimensionAnnotation;
+  const [favName, setFavName] = useState("");
+  const [msg, setMsg] = useState("");
+  const kind = d.kind ?? "linear";
+  const angle = kind === "angular";
+  const radial = kind === "diameter" || kind === "radius";
+  const symbol = kind === "diameter" ? "Ø" : kind === "radius" ? "R" : "";
+  const value = said?.value;
+  const places = d.precision ?? env.drawing.precision;
+  const shown = value === undefined ? "—" : `${symbol}${angle ? `${Math.round(value * 100) / 100}°` : value.toFixed(places ?? (Number.isInteger(Math.round(value * 1000) / 1000) ? 0 : 2))}`;
+  const favs = [...BUILT_IN_FAVOURITES, ...loadFavourites()];
+  const put = (patch: Record<string, unknown>) => setMsg(write(patch) ?? "");
+  const tolKind = d.tolerance?.kind;
+  return (
+    <div className="dim-panel" data-testid="dim-panel">
+      <div className="dim-value">
+        <span className="dim-value-label">Value</span>
+        <span className="dim-value-number mono" data-testid="dim-value">
+          {shown}
+        </span>
+        <span className={`badge${d.override ? " warn" : ""}`}>{d.override ? "overridden" : "driven by the model"}</span>
+      </div>
+      <Row label="Override" hint="Text written instead of the measured value: it no longer follows the model">
+        <Commit value={d.override ?? ""} placeholder="the measured value" onCommit={(s) => put({ override: s.trim() || null })} testId="dim-override" />
+      </Row>
+      {d.override && (
+        <p className="warn-line" role="alert" data-testid="dim-override-warning">
+          ⚠ The model measures {shown}; this dimension shows “{d.override}” and won't follow changes. Clear the override to drive it again.
+        </p>
+      )}
+      <Row label="Favourite">
+        <span className="fav-row">
+          <select
+            value=""
+            onChange={(e) => {
+              const f = favs.find((x) => x.name === e.target.value);
+              if (!f) return;
+              const p = applyFavourite(d, f);
+              if (typeof p === "string") return setMsg(p);
+              put(p);
+            }}
+            data-testid="dim-fav"
+          >
+            <option value="">apply…</option>
+            {favs.map((f) => (
+              <option key={f.name} value={f.name}>
+                {f.name}
+              </option>
+            ))}
+          </select>
+          <input value={favName} placeholder="name" onChange={(e) => setFavName(e.target.value)} onKeyDown={(e) => e.stopPropagation()} style={{ width: 80 }} data-testid="dim-fav-name" />
+          <button
+            type="button"
+            onClick={() => {
+              const f = favouriteFrom(favName, d);
+              if (typeof f === "string") return setMsg(f);
+              storeFavourites([...loadFavourites().filter((x) => x.name !== f.name), f]);
+              setFavName("");
+              setMsg(`Saved “${f.name}”: it is in the list of favourites and in Smart Dimension's styles.`);
+            }}
+            data-testid="dim-fav-save"
+          >
+            Save
+          </button>
+        </span>
+      </Row>
+      <ToleranceEditor value={d.tolerance} size={value} symbol={symbol} angle={angle} prefix="dim" onChange={(t) => write({ tolerance: t })} />
+      <div className="dim-text">
+        <Row label="Before">
+          <Commit value={d.prefix ?? ""} placeholder="Ø, SR, 4×" onCommit={(s) => put({ prefix: s || null })} testId="dim-prefix" />
+        </Row>
+        <SymbolPalette testId="dim-symbols" onPick={(ch) => put({ prefix: `${d.prefix ?? ""}${ch}` })} />
+        <Row label="After">
+          <Commit value={d.suffix ?? ""} placeholder="THRU" onCommit={(s) => put({ suffix: s || null })} testId="dim-suffix" />
+        </Row>
+        <Row label="Below">
+          <Commit value={d.below ?? ""} placeholder="2 PLACES" onCommit={(s) => put({ below: s || null })} testId="dim-below" />
+        </Row>
+        <div className="tol-fields">
+          <Row label="Count n×">
+            <Commit value={d.count ? String(d.count) : ""} placeholder="1" numeric width={56} onCommit={(s) => {
+              const n = numberOf(s);
+              if (n !== undefined && (!Number.isInteger(n) || n < 1)) return setMsg(`Count is how many alike features, a whole number (got "${s}")`);
+              put({ count: n && n > 1 ? n : null });
+            }} testId="dim-count" />
+          </Row>
+          <label className="check">
+            <input type="checkbox" checked={!!d.typ} onChange={(e) => put({ typ: e.target.checked || null })} data-testid="dim-typ" /> TYP
+          </label>
+        </div>
+      </div>
+      <div className="tol-fields">
+        <Row label="Decimals">
+          <select value={d.precision ?? ""} onChange={(e) => put({ precision: e.target.value === "" ? null : Number(e.target.value) })} data-testid="dim-precision">
+            <option value="">drawing's ({env.drawing.precision ?? "as needed"})</option>
+            {[0, 1, 2, 3, 4].map((n) => (
+              <option key={n} value={n}>
+                {n === 0 ? "12" : `12.${"0".repeat(n)}`}
+              </option>
+            ))}
+          </select>
+        </Row>
+        <label className="check" title="The other unit too, in brackets">
+          <input type="checkbox" checked={d.dual ?? env.drawing.dualUnits ?? false} onChange={(e) => put({ dual: e.target.checked })} data-testid="dim-dual" /> Dual units
+        </label>
+      </div>
+      {radial && d.refs?.length === 1 && (
+        <Row label="Display as">
+          <Segmented label="Display as" value={kind as "diameter" | "radius"} options={[["diameter", "Ø diameter"], ["radius", "R radius"]]} onChange={(k) => put({ kind: k })} testId="dim-as" />
+        </Row>
+      )}
+      <Row label="Arrows" hint="Click an arrowhead on the sheet to flip them">
+        <Segmented label="Arrows" value={d.arrows ?? "auto"} options={[["auto", "Auto"], ["inside", "Inside"], ["outside", "Outside"]]} onChange={(v) => put({ arrows: v === "auto" ? null : v })} testId="dim-arrows" />
+      </Row>
+      <div className="dim-flags">
+        <label className="check">
+          <input type="checkbox" checked={!!d.flip} onChange={(e) => put({ flip: e.target.checked || null })} data-testid="dim-flip" /> Flip
+        </label>
+        <label className="check" title="The theoretically exact size, boxed (GD&T)">
+          <input type="checkbox" checked={tolKind === "basic"} onChange={(e) => put({ tolerance: e.target.checked ? { kind: "basic" } : null })} data-testid="dim-basic" /> Basic
+        </label>
+        <label className="check" title="For information, in brackets">
+          <input type="checkbox" checked={tolKind === "reference"} onChange={(e) => put({ tolerance: e.target.checked ? { kind: "reference" } : null })} data-testid="dim-reference" /> Reference
+        </label>
+        <label className="check" title="Checked at inspection: in an oval">
+          <input type="checkbox" checked={!!d.inspection} onChange={(e) => put({ inspection: e.target.checked || null })} data-testid="dim-inspection" /> Inspection
+        </label>
+      </div>
+      {msg && (
+        <p className={msg.startsWith("Saved") ? "muted small" : "field-error"} role="status">
+          {msg}
+        </p>
+      )}
+    </div>
+  );
+}
+
+// ------------------------------------------------------------ the hole callout's bore tolerance
+
+const hole = annotationKind("hole")!;
+registerAnnotationKind({
+  ...annotationKind("hole")!,
+  panel: ({ a, write, env }) => {
+    const sheet = env.sheet as ComposedSheet | null;
+    const rec = sheet?.points.holes.get(String(a.hole));
+    return <ToleranceEditor value={a.tolerance as Tolerance | undefined} size={rec?.diameter} symbol="Ø" prefix="hole" onChange={(t) => write({ tolerance: t })} />;
+  },
+});
+void hole;
diff --git a/src/ui/drawing/tools/balloons.ts b/src/ui/drawing/tools/balloons.ts
new file mode 100644
index 0000000..1df948a
--- /dev/null
+++ b/src/ui/drawing/tools/balloons.ts
@@ -0,0 +1,101 @@
+// Auto Balloon (Phase Q wave Q3A): a balloon for every cut list (or BOM)
+// item that a view shows and that has none yet, each on the member or body
+// it numbers, arranged by a layout: round the view where each one is free
+// (the engine places them), or in a row above or below it, a column to its
+// left or right, or square round it, in the order their parts are, so the
+// leaders don't cross. Pure.
+
+import type { Annotation, BalloonAnnotation, Vec2 } from "../../../doc/types";
+import { visibleAnchor } from "../../../drafting/annotate";
+import type { ComposedSheet, ComposedView } from "../../../drafting/compose";
+import { viewToSheet } from "../../../drafting/compose";
+
+export const BALLOON_LAYOUTS = ["around", "top", "bottom", "left", "right", "square"] as const;
+export type BalloonLayout = (typeof BALLOON_LAYOUTS)[number];
+
+export interface AutoBalloonOptions {
+  /** The views to balloon (default: every view on the sheet), the first that shows an item gets it. */
+  views?: string[];
+  layout?: BalloonLayout;
+  /** Distance of a row or column from the view, sheet mm (default 14). */
+  gap?: number;
+}
+
+/** The balloons to add (without ids), and the items no view shows. */
+export function autoBalloons(sheet: ComposedSheet, existing: Annotation[], opts: AutoBalloonOptions = {}): { balloons: Omit<BalloonAnnotation, "id">[]; unseen: number[] } {
+  const layout = opts.layout ?? "around";
+  const gap = opts.gap ?? 14;
+  const views = (opts.views ?? sheet.views.map((v) => v.id)).map((id) => sheet.views.find((v) => v.id === id)).filter((v): v is ComposedView => !!v?.box);
+  const said = new Map(sheet.annotations.map((a) => [a.id, a]));
+  const done = new Set<number>();
+  for (const a of existing) {
+    if (a.type !== "balloon") continue;
+    const item = a.item ?? said.get(a.id)?.item;
+    if (item !== undefined) done.add(item);
+  }
+  const memberBody = new Map(sheet.points.members.map((m) => [m.id, m.body]));
+  const picks = new Map<string, { view: ComposedView; member: string; at: Vec2 }[]>();
+  const unseen: number[] = [];
+  for (const item of sheet.cutList) {
+    if (done.has(item.item)) continue;
+    let placed = false;
+    for (const cv of views) {
+      // The member of the item that shows most in this view.
+      let best: { member: string; at: Vec2; length: number } | null = null;
+      for (const m of item.members) {
+        const body = memberBody.get(m);
+        const anchor = body ? visibleAnchor(cv, body) : null;
+        if (anchor && (!best || anchor.length > best.length)) best = { member: m, at: viewToSheet(cv, anchor.at), length: anchor.length };
+      }
+      if (!best) continue;
+      picks.set(cv.id, [...(picks.get(cv.id) ?? []), { view: cv, member: best.member, at: best.at }]);
+      placed = true;
+      break;
+    }
+    if (!placed) unseen.push(item.item);
+  }
+  const balloons: Omit<BalloonAnnotation, "id">[] = [];
+  for (const list of picks.values()) {
+    const cv = list[0].view;
+    const b = cv.box!;
+    const rel = (p: Vec2): Vec2 => [Math.round((p[0] - cv.centre[0]) * 10) / 10 + 0, Math.round((p[1] - cv.centre[1]) * 10) / 10 + 0];
+    const spread = (n: number, lo: number, hi: number, i: number) => (n === 1 ? (lo + hi) / 2 : lo + ((hi - lo) * i) / (n - 1));
+    if (layout === "around") {
+      for (const x of list) balloons.push({ type: "balloon", view: cv.id, member: x.member });
+      continue;
+    }
+    if (layout === "top" || layout === "bottom") {
+      const sorted = [...list].sort((p, q) => p.at[0] - q.at[0]);
+      const y = layout === "top" ? b.max[1] + gap : b.min[1] - gap;
+      const w = Math.max(b.max[0] - b.min[0], 12 * (sorted.length - 1));
+      const mid = (b.min[0] + b.max[0]) / 2;
+      sorted.forEach((x, i) => balloons.push({ type: "balloon", view: cv.id, member: x.member, at: rel([spread(sorted.length, mid - w / 2, mid + w / 2, i), y]) }));
+      continue;
+    }
+    if (layout === "left" || layout === "right") {
+      const sorted = [...list].sort((p, q) => q.at[1] - p.at[1]);
+      const x0 = layout === "right" ? b.max[0] + gap : b.min[0] - gap;
+      const h = Math.max(b.max[1] - b.min[1], 12 * (sorted.length - 1));
+      const mid = (b.min[1] + b.max[1]) / 2;
+      sorted.forEach((x, i) => balloons.push({ type: "balloon", view: cv.id, member: x.member, at: rel([x0, spread(sorted.length, mid + h / 2, mid - h / 2, i)]) }));
+      continue;
+    }
+    // Square: each on the box round the view, in the direction of its part from the view's middle, in angle order.
+    const c: Vec2 = [(b.min[0] + b.max[0]) / 2, (b.min[1] + b.max[1]) / 2];
+    const hw = (b.max[0] - b.min[0]) / 2 + gap;
+    const hh = (b.max[1] - b.min[1]) / 2 + gap;
+    const onBox = (ang: number): Vec2 => {
+      const d: Vec2 = [Math.cos(ang), Math.sin(ang)];
+      const t = Math.min(Math.abs(d[0]) > 1e-9 ? hw / Math.abs(d[0]) : Infinity, Math.abs(d[1]) > 1e-9 ? hh / Math.abs(d[1]) : Infinity);
+      return [c[0] + d[0] * t, c[1] + d[1] * t];
+    };
+    const angles = list.map((x) => Math.atan2(x.at[1] - c[1], x.at[0] - c[0]));
+    const order = list.map((_, i) => i).sort((i, j) => angles[i] - angles[j]);
+    // Keep neighbours at least 12 mm apart along the box: spread their angles out where they bunch.
+    const minStep = (2 * Math.PI) / Math.max(order.length, 1) / 2;
+    const placed = order.map((i) => angles[i]);
+    for (let k = 1; k < placed.length; k++) placed[k] = Math.max(placed[k], placed[k - 1] + Math.min(minStep, 0.35));
+    order.forEach((i, k) => balloons.push({ type: "balloon", view: cv.id, member: list[i].member, at: rel(onBox(placed[k])) }));
+  }
+  return { balloons, unseen };
+}
diff --git a/src/ui/drawing/tools/dimensionTools.tsx b/src/ui/drawing/tools/dimensionTools.tsx
new file mode 100644
index 0000000..fde5b64
--- /dev/null
+++ b/src/ui/drawing/tools/dimensionTools.tsx
@@ -0,0 +1,774 @@
+// The dimensioning tools (Phase Q wave Q3A): Smart Dimension (D) inferred
+// from what is picked, its preview following the pointer exactly as it will
+// be drawn; chain, baseline and ordinate sets; the chamfer dimension; the
+// hole callout; centre marks (one, a row, a bolt circle) and centre lines
+// (two edges, two centres, or one side of a cylinder); Model Items (the
+// part's own dimensions brought into chosen views). Each replaces or fills
+// the slot Q2B named, by id.
+
+import type { ReactNode } from "react";
+import type { Command } from "../../../doc/commands";
+import type { DimensionDirection, Vec2 } from "../../../doc/types";
+import { validateDocument } from "../../../doc/validate";
+import { centerlineFromPicks, centerMarkFromPick, holeFromPick } from "../../../drafting/annotate";
+import type { SnapKind, SnapTarget } from "../snap";
+import { keep } from "./editing";
+import { centreRef, inferDimension, setFromPicks, type DimPick, type InferOptions } from "./inference";
+import { modelItems } from "./modelItems";
+import { registerDrawingTool } from "./registry";
+import { BUILT_IN_FAVOURITES, applyFavourite, loadFavourites, type DimFavourite } from "./styles";
+import { ToolSession, noViews } from "./toolSession";
+import type { DrawingToolCtx, OverlayShape, SheetPointer } from "./types";
+import { Row, Segmented } from "./ui";
+
+const POINTS: SnapKind[] = ["vertex", "centre", "midpoint", "quadrant"];
+const ALL: SnapKind[] = [...POINTS, "edge", "circle", "arc"];
+const square = (c: DrawingToolCtx, view: string) => c.sheet?.views.find((v) => v.id === view)?.square ?? false;
+const pickOf = (s: SnapTarget): DimPick => ({ ref: s.ref, kind: s.kind, view: s.view, at: s.at });
+const favourites = (): DimFavourite[] => [...BUILT_IN_FAVOURITES, ...loadFavourites()];
+
+// ------------------------------------------------------------ Smart Dimension
+
+export class SmartDimensionSession extends ToolSession {
+  picks: SnapTarget[] = [];
+  radial: InferOptions["radial"];
+  lock: DimensionDirection | undefined;
+  /** A favourite every new dimension gets ("±0.1", "H7"). */
+  style: string = "";
+  constructor(get: () => DrawingToolCtx) {
+    super("annotation.smartDimension", get);
+  }
+  name() {
+    return "Smart Dimension";
+  }
+  busy() {
+    return this.picks.length > 0;
+  }
+  reset() {
+    this.picks = [];
+  }
+  prompt() {
+    if (!this.picks.length) return "Click an edge, a circle, an arc or a point (two for a distance or an angle)";
+    const p = this.picks[0];
+    if (this.picks.length === 1 && POINTS.includes(p.kind)) return "Click a second point or an edge";
+    if (this.picks.length === 1) return "Click where the dimension goes, or a second item (an edge for an angle or a distance)";
+    return "Click where the dimension goes (where the pointer is picks across, up, along, or the angle's quadrant)";
+  }
+  snaps() {
+    return this.picks.length < 2 ? { kinds: ALL, view: this.picks[0]?.view ?? null } : { kinds: [] as SnapKind[] };
+  }
+  opts(): InferOptions {
+    return { ...(this.radial ? { radial: this.radial } : {}), ...(this.lock ? { direction: this.lock } : {}) };
+  }
+  /** The dimension the picks (and a candidate) make with the text at `at`. */
+  infer(picks: SnapTarget[], at: Vec2) {
+    const sheet = this.ctx().sheet;
+    if (!sheet) return "The sheet is still being drawn";
+    return inferDimension(sheet, picks.map(pickOf), at, this.opts());
+  }
+  /** A hovered item that would be a good second pick. */
+  candidate(p: SheetPointer | null): SnapTarget | null {
+    const s = p?.snap;
+    if (!s || this.picks.length !== 1 || this.picks.some((x) => x.ref === s.ref) || s.view !== this.picks[0].view) return null;
+    return typeof this.infer([...this.picks, s], p!.raw) === "string" ? null : s;
+  }
+  click(p: SheetPointer) {
+    const c = this.ctx();
+    const s = p.snap;
+    if (!this.picks.length) {
+      if (!s) return c.notice("Click an edge, a circle or a point of a view.", "error");
+      if (!square(c, s.view)) return c.notice(`${s.view} looks at the part at an angle, which shortens every length: dimension in a front, top, side or section view.`, "error");
+      this.picks = [s];
+      return c.refresh();
+    }
+    if (s && this.picks.length === 1 && !this.picks.some((x) => x.ref === s.ref)) {
+      if (this.candidate(p)) {
+        this.picks.push(s);
+        return c.refresh();
+      }
+      if (POINTS.includes(this.picks[0].kind)) return c.notice(String(this.infer([...this.picks, s], p.raw)), "error");
+    }
+    this.place(p.raw);
+  }
+  place(at: Vec2) {
+    const c = this.ctx();
+    const d = this.infer(this.picks, at);
+    if (typeof d === "string") return c.notice(d, "error");
+    const fav = favourites().find((f) => f.name === this.style);
+    const extra = fav ? applyFavourite({ id: "", ...d }, fav) : {};
+    if (typeof extra === "string") c.notice(extra);
+    if (this.add({ ...d, ...(typeof extra === "string" ? {} : extra) })) this.picks = [];
+    c.refresh();
+  }
+  key(e: KeyboardEvent) {
+    const k = e.key.toLowerCase();
+    if (e.key === "Backspace" && this.picks.length) {
+      this.picks.pop();
+      this.ctx().refresh();
+      return true;
+    }
+    if (k === "r" && !e.ctrlKey) {
+      this.radial = this.radial === "diameter" ? "radius" : this.radial === "radius" ? undefined : "diameter";
+      this.ctx().refresh();
+      return true;
+    }
+    const locks: Record<string, DimensionDirection> = { h: "horizontal", v: "vertical", a: "aligned" };
+    if (locks[k] && !e.ctrlKey) {
+      this.lock = this.lock === locks[k] ? undefined : locks[k];
+      this.ctx().refresh();
+      return true;
+    }
+    return false;
+  }
+  overlay(): OverlayShape[] {
+    const out: OverlayShape[] = this.picks.flatMap((t) => this.highlight(t));
+    const h = this.hover;
+    if (!this.picks.length || !h) return out;
+    const cand = this.candidate(h);
+    if (cand) out.push(...this.highlight(cand, "preview"));
+    const picks = cand ? [...this.picks, cand] : this.picks;
+    if (picks.length === 1 && POINTS.includes(picks[0].kind)) return out;
+    return [...out, ...this.preview(this.infer(picks, h.raw), h.raw)];
+  }
+  panel(): ReactNode {
+    const set = (f: () => void) => {
+      f();
+      this.ctx().refresh();
+    };
+    return (
+      <div className="session-options">
+        <Row label="Circles and arcs" hint="R toggles">
+          <Segmented
+            label="Circles and arcs"
+            value={this.radial ?? "auto"}
+            options={[
+              ["auto", "Auto", "A circle by its diameter, an arc by its radius"],
+              ["diameter", "Ø", "Diameter"],
+              ["radius", "R", "Radius"],
+            ]}
+            onChange={(v) => set(() => (this.radial = v === "auto" ? undefined : v))}
+            testId="dim-radial"
+          />
+        </Row>
+        <Row label="Direction" hint="H, V, A lock it">
+          <Segmented
+            label="Direction"
+            value={this.lock ?? "auto"}
+            options={[
+              ["auto", "Pointer", "Across, up or along by where the pointer is"],
+              ["horizontal", "H", "Horizontal"],
+              ["vertical", "V", "Vertical"],
+              ["aligned", "Along", "Aligned with the points"],
+            ]}
+            onChange={(v) => set(() => (this.lock = v === "auto" ? undefined : v))}
+            testId="dim-lock"
+          />
+        </Row>
+        <Row label="New dimensions get" hint="A favourite style each new dimension takes">
+          <select value={this.style} onChange={(e) => set(() => (this.style = e.target.value))} data-testid="dim-style">
+            <option value="">no tolerance</option>
+            {favourites().map((f) => (
+              <option key={f.name} value={f.name}>
+                {f.name}
+              </option>
+            ))}
+          </select>
+        </Row>
+        <div className="drawing-buttons">
+          {(["chain", "baseline", "ordinate"] as const).map((m) => (
+            <button key={m} type="button" onClick={() => this.ctx().startSession?.(new SetSession(this.ctx, m))} data-testid={`dim-mode-${m}`} title={`${m[0].toUpperCase()}${m.slice(1)} dimensions: an origin, then points`}>
+              {m[0].toUpperCase() + m.slice(1)}
+            </button>
+          ))}
+        </div>
+        <p className="muted small">Two edges at an angle: the angle, of the quadrant the pointer is in. A point and an edge: the distance square from it. A cylinder's two sides: Ø. Backspace drops the last pick; Esc lets go.</p>
+      </div>
+    );
+  }
+}
+
+registerDrawingTool({
+  id: "annotation.smartDimension",
+  tab: "annotation",
+  group: "dimension",
+  label: "Smart Dimension",
+  icon: "smartDimension",
+  title: "Dimension what you pick: an edge's length, a circle's Ø, an arc's R, two points, two edges' distance or angle, a cylinder's Ø; the preview follows the pointer",
+  key: "D",
+  testId: "tool-annotation-dimension",
+  disabled: noViews,
+  run: (get) => new SmartDimensionSession(get),
+});
+
+// ------------------------------------------------------------ chain, baseline, ordinate
+
+type SetMode = "chain" | "baseline" | "ordinate";
+
+export class SetSession extends ToolSession {
+  origin: SnapTarget | null = null;
+  points: SnapTarget[] = [];
+  constructor(
+    get: () => DrawingToolCtx,
+    public mode: SetMode,
+  ) {
+    super(`annotation.${mode}Dimension`, get);
+  }
+  name() {
+    return `${this.mode[0].toUpperCase()}${this.mode.slice(1)} dimensions`;
+  }
+  busy() {
+    return !!this.origin;
+  }
+  reset() {
+    this.origin = null;
+    this.points = [];
+  }
+  prompt() {
+    if (!this.origin) return this.mode === "chain" ? "Click the chain's first point" : "Click the origin (a corner, an edge's end, a hole's centre)";
+    return this.points.length ? "Click more points; click off the part (or double-click) to place the set" : "Click the points to measure";
+  }
+  snaps() {
+    return { kinds: [...POINTS, "circle", "arc"] as SnapKind[], view: this.origin?.view ?? null };
+  }
+  refOf(s: SnapTarget): string {
+    return s.kind === "circle" || s.kind === "arc" ? centreRef(s.ref) : s.ref;
+  }
+  set(at: Vec2, extra?: SnapTarget) {
+    const sheet = this.ctx().sheet;
+    if (!sheet || !this.origin) return "Click the origin first";
+    return setFromPicks(sheet, this.mode, this.refOf(this.origin), [...this.points, ...(extra ? [extra] : [])].map((s) => this.refOf(s)), at);
+  }
+  click(p: SheetPointer) {
+    const c = this.ctx();
+    const s = p.snap;
+    if (s) {
+      if (!this.origin) {
+        if (!square(c, s.view)) return c.notice(`${s.view} looks at the part at an angle: dimension in a square view.`, "error");
+        this.origin = s;
+        return c.refresh();
+      }
+      if (s.view === this.origin.view && ![this.origin, ...this.points].some((x) => this.refOf(x) === this.refOf(s))) {
+        this.points.push(s);
+        return c.refresh();
+      }
+    }
+    this.place(p.raw);
+  }
+  doubleClick(p: SheetPointer) {
+    this.place(p.raw);
+  }
+  place(at: Vec2) {
+    const c = this.ctx();
+    if (!this.origin || !this.points.length) return c.notice(this.prompt(), "error");
+    const d = this.set(at);
+    if (typeof d === "string") return c.notice(d, "error");
+    if (this.add(d)) this.reset();
+    c.refresh();
+  }
+  key(e: KeyboardEvent) {
+    if (e.key === "Backspace" && this.origin) {
+      if (this.points.length) this.points.pop();
+      else this.origin = null;
+      this.ctx().refresh();
+      return true;
+    }
+    return false;
