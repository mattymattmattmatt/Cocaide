+// A tool's annotation laid out before it is kept (Phase Q wave Q3A): the
+// engine lays it out in the context the sheet was composed in (its views,
+// its data, what is already where), so the preview that follows the pointer
+// is exactly what OK will draw: the same arrowheads, text, tolerance stack.
+// `standard` lays it out to the other standard (the weld builder's ISO/AWS
+// preview) without changing the drawing.
+
+import type { Annotation } from "../../../doc/types";
+import { draftStyle, layoutAnnotation, measureDimension, type AnnotationLayout } from "../../../drafting/annotate";
+import { LAYOUT_CONTEXT, type ComposedSheet } from "../../../drafting/compose";
+
+/** The annotation as it would be drawn on the sheet, or null when the sheet has no layout context (or it can't be drawn: `problem`). */
+export function previewAnnotation(sheet: ComposedSheet | null, a: Annotation, opts: { standard?: "ISO" | "ASME" } = {}): AnnotationLayout | null {
+  if (!sheet) return null;
+  const base = LAYOUT_CONTEXT.get(sheet);
+  if (!base) return null;
+  const ctx = opts.standard && opts.standard !== (base.drawing.standard ?? "ISO") ? { ...base, style: draftStyle(opts.standard, sheet.template), drawing: { ...base.drawing, standard: opts.standard } } : base;
+  try {
+    if (a.type === "dimension") {
+      const cv = sheet.views.find((v) => v.id === a.view);
+      if (!cv) return null;
+      const m = measureDimension(a, { id: cv.id, edges: cv.edges, frame: cv.frame, outline: cv.outline, square: cv.square }, sheet.points, sheet.points.members);
+      return layoutAnnotation(a, ctx, m);
+    }
+    return layoutAnnotation(a, ctx);
+  } catch {
+    // A half-made annotation the engine can't lay out yet: no preview.
+    return null;
+  }
+}
diff --git a/src/ui/drawing/tools/sketchTools.tsx b/src/ui/drawing/tools/sketchTools.tsx
new file mode 100644
index 0000000..bcebe8a
--- /dev/null
+++ b/src/ui/drawing/tools/sketchTools.tsx
@@ -0,0 +1,229 @@
+// Sketching on the sheet (Phase Q wave Q3A): lines (one after another, Shift
+// keeps them square), rectangles, circles, arcs and text, drawn in a line
+// type of ISO 128 (thick, thin, centre, hidden, phantom). They snap to the
+// views' points; each shape is its own sketch annotation (one undo step),
+// dragged and nudged like any annotation.
+
+import type { ReactNode } from "react";
+import { SKETCH_LINES, type SketchItem, type SketchLine, type Vec2 } from "../../../doc/types";
+import { tenth } from "../align";
+import type { SnapKind } from "../snap";
+import { annotationKind, registerAnnotationKind } from "./kinds";
+import { registerDrawingTool } from "./registry";
+import { ToolSession } from "./toolSession";
+import type { DrawingToolCtx, OverlayShape, SheetPointer } from "./types";
+import { Commit, numberOf, Row } from "./ui";
+
+type Shape = "line" | "rectangle" | "circle" | "arc";
+const SNAPS: SnapKind[] = ["vertex", "centre", "midpoint", "quadrant"];
+const r1 = (p: Vec2): Vec2 => [tenth(p[0]), tenth(p[1])];
+
+/** The items a shape makes from its clicked points (arc: centre, start, end; counter-clockwise). */
+export function sketchItems(shape: Shape, pts: Vec2[], line?: SketchLine): SketchItem[] | null {
+  const st = line && line !== "thick" ? { line } : {};
+  const [a, b, c] = pts;
+  if (shape === "line" && a && b) return Math.hypot(b[0] - a[0], b[1] - a[1]) > 1e-6 ? [{ kind: "line", a, b, ...st }] : null;
+  if (shape === "rectangle" && a && b) return Math.abs(b[0] - a[0]) > 1e-6 && Math.abs(b[1] - a[1]) > 1e-6 ? [{ kind: "rect", a, b, ...st }] : null;
+  if (shape === "circle" && a && b) {
+    const r = tenth(Math.hypot(b[0] - a[0], b[1] - a[1]));
+    return r > 0 ? [{ kind: "circle", c: a, r, ...st }] : null;
+  }
+  if (shape === "arc" && a && b && c) {
+    const r = tenth(Math.hypot(b[0] - a[0], b[1] - a[1]));
+    const ang = (p: Vec2) => tenth((((Math.atan2(p[1] - a[1], p[0] - a[0]) * 180) / Math.PI) % 360 + 360) % 360);
+    return r > 0 ? [{ kind: "arc", c: a, r, start: ang(b), end: ang(c), ...st }] : null;
+  }
+  return null;
+}
+
+const NEED: Record<Shape, number> = { line: 2, rectangle: 2, circle: 2, arc: 3 };
+const ASK: Record<Shape, string[]> = {
+  line: ["Click the line's start", "Click its end (Shift: square); it goes on from there"],
+  rectangle: ["Click a corner", "Click the opposite corner"],
+  circle: ["Click the centre", "Click a point on the circle"],
+  arc: ["Click the centre", "Click where the arc starts", "Click where it ends (counter-clockwise)"],
+};
+
+class SketchSession extends ToolSession {
+  pts: Vec2[] = [];
+  line: SketchLine;
+  constructor(
+    get: () => DrawingToolCtx,
+    readonly shape: Shape,
+  ) {
+    super(`sketch.${shape}`, get);
+    this.line = shape === "line" || shape === "rectangle" || shape === "circle" || shape === "arc" ? "thick" : "thin";
+  }
+  name() {
+    return { line: "Line", rectangle: "Rectangle", circle: "Circle", arc: "Arc" }[this.shape];
+  }
+  busy() {
+    return this.pts.length > 0;
+  }
+  reset() {
+    this.pts = [];
+  }
+  prompt() {
+    return ASK[this.shape][Math.min(this.pts.length, ASK[this.shape].length - 1)];
+  }
+  snaps() {
+    return { kinds: SNAPS };
+  }
+  point(p: SheetPointer): Vec2 {
+    let q = p.snap ? p.at : p.raw;
+    const last = this.pts[this.pts.length - 1];
+    if (p.shift && last && this.shape === "line") q = Math.abs(q[0] - last[0]) >= Math.abs(q[1] - last[1]) ? [q[0], last[1]] : [last[0], q[1]];
+    return r1(q);
+  }
+  click(p: SheetPointer) {
+    const c = this.ctx();
+    this.pts.push(this.point(p));
+    if (this.pts.length < NEED[this.shape]) return c.refresh();
+    const items = sketchItems(this.shape, this.pts, this.line);
+    if (!items) {
+      this.pts.pop();
+      return c.notice("That shape has no size: click further away", "error");
+    }
+    if (this.add({ type: "sketch", items })) this.pts = this.shape === "line" ? [this.pts[this.pts.length - 1]] : [];
+    c.refresh();
+  }
+  doubleClick() {
+    this.pts = [];
+    this.ctx().refresh();
+  }
+  overlay(): OverlayShape[] {
+    const h = this.hover;
+    if (!h || !this.pts.length) return [];
+    const items = sketchItems(this.shape, [...this.pts, this.point(h)].slice(0, NEED[this.shape]), this.line);
+    if (this.shape === "arc" && this.pts.length === 1) return [{ k: "circle", c: this.pts[0], r: Math.hypot(h.raw[0] - this.pts[0][0], h.raw[1] - this.pts[0][1]), tone: "preview", dash: true }];
+    return items ? this.preview({ type: "sketch", items }) : [];
+  }
+  panel(): ReactNode {
+    return <LineType value={this.line} onChange={(l) => {
+      this.line = l;
+      this.ctx().refresh();
+    }} />;
+  }
+}
+
+function LineType({ value, onChange }: { value: SketchLine; onChange(l: SketchLine): void }) {
+  return (
+    <div className="session-options">
+      <Row label="Line">
+        <select value={value} onChange={(e) => onChange(e.target.value as SketchLine)} data-testid="sketch-line-type">
+          {SKETCH_LINES.map((l) => (
+            <option key={l} value={l}>
+              {{ thick: "thick (visible outline)", thin: "thin", center: "centre (chain)", hidden: "hidden (dashed)", phantom: "phantom" }[l]}
+            </option>
+          ))}
+        </select>
+      </Row>
+    </div>
+  );
+}
+
+for (const [shape, label, icon] of [
+  ["line", "Line", "line"],
+  ["rectangle", "Rectangle", "rect"],
+  ["circle", "Circle", "circle"],
+  ["arc", "Arc", "arc"],
+] as const) {
+  registerDrawingTool({ id: `sketch.${shape}`, tab: "sketch", group: "draw", label, icon, title: `A ${label.toLowerCase()} drawn on the sheet, in a line type of your choice; it snaps to the views' points`, testId: `tool-sketch-${shape}`, run: (get) => new SketchSession(get, shape) });
+}
+
+// ------------------------------------------------------------ text
+
+class TextSession extends ToolSession {
+  text = "";
+  height = "";
+  at: Vec2 | null = null;
+  constructor(get: () => DrawingToolCtx) {
+    super("sketch.text", get);
+  }
+  name() {
+    return "Text";
+  }
+  busy() {
+    return !!this.at;
+  }
+  reset() {
+    this.at = null;
+  }
+  prompt() {
+    return this.at ? "Type it in the panel; Enter keeps it" : "Click where the text goes";
+  }
+  click(p: SheetPointer) {
+    this.at = r1(p.raw);
+    this.ctx().refresh();
+    requestAnimationFrame(() => (document.querySelector('[data-testid="note-text"]') as HTMLInputElement | null)?.focus());
+  }
+  item(): Record<string, unknown> & { type: string } {
+    const h = numberOf(this.height);
+    return { type: "text", text: this.text, at: this.at!, ...(h && h > 0 ? { height: h } : {}) };
+  }
+  ok(): string | null {
+    if (!this.at) {
+      this.ctx().end();
+      return null;
+    }
+    if (!this.text.trim()) return "Type the text";
+    if (!this.add({ ...this.item(), text: this.text.trim() })) return "refused";
+    this.ctx().end();
+    return null;
+  }
+  overlay(): OverlayShape[] {
+    const at = this.at ?? this.hover?.raw;
+    if (!at) return [];
+    return this.at && this.text.trim() ? this.preview(this.item(), at) : [{ k: "dot", at, tone: "accent" }];
+  }
+  panel(): ReactNode {
+    const c = this.ctx();
+    return (
+      <div className="session-options">
+        <input
+          type="text"
+          value={this.text}
+          placeholder="Text"
+          onChange={(e) => {
+            this.text = e.target.value;
+            c.refresh();
+          }}
+          onKeyDown={(e) => {
+            if (e.key === "Enter") {
+              e.preventDefault();
+              const why = this.ok();
+              if (why) c.notice(why, "error");
+            }
+          }}
+          data-testid="note-text"
+        />
+        <Row label="Height">
+          <Commit value={this.height} numeric width={60} placeholder="3.5" onCommit={(s) => {
+            this.height = s;
+            c.refresh();
+          }} testId="text-height" />
+        </Row>
+      </div>
+    );
+  }
+}
+
+registerDrawingTool({ id: "sketch.text", tab: "sketch", group: "text", label: "Text", icon: "sketchText", title: "Text on the sheet: click where it goes, then type it", testId: "tool-sketch-text", run: (get) => new TextSession(get) });
+
+// A sketch drags and nudges as a whole: every point of every item moves.
+const sketch = annotationKind("sketch");
+if (sketch) {
+  registerAnnotationKind({
+    ...sketch,
+    move: (a, d) => {
+      const mv = (p: Vec2): Vec2 => [tenth(p[0] + d[0]), tenth(p[1] + d[1])];
+      const items = ((a.items as SketchItem[]) ?? []).map((it) => {
+        if (it.kind === "line" || it.kind === "rect") return { ...it, a: mv(it.a), b: mv(it.b) };
+        if (it.kind === "circle" || it.kind === "arc") return { ...it, c: mv(it.c) };
+        if (it.kind === "polyline") return { ...it, pts: it.pts.map(mv) };
+        return { ...it, at: mv(it.at) };
+      });
+      return { items };
+    },
+  });
+}
diff --git a/src/ui/drawing/tools/styles.ts b/src/ui/drawing/tools/styles.ts
new file mode 100644
index 0000000..4b5c36f
--- /dev/null
+++ b/src/ui/drawing/tools/styles.ts
@@ -0,0 +1,175 @@
+// Annotation styles (Phase Q wave Q3A): what the Format Painter copies from
+// one annotation to others of its kind (a dimension's tolerance, decimals,
+// arrows, dual units, inspection; a note's height and weight; a balloon's
+// shape), the dimension favourites ("±0.1", "H7", saved by the user), and
+// the ISO 286 classes the fit editor offers, with their deviations at the
+// size being dimensioned. Pure.
+
+import type { Annotation, DimensionAnnotation } from "../../../doc/types";
+import { classDeviations, fitOf, parseFit, type FitType } from "../../../drafting/fits";
+import { deviationText, numberText, toleranceProblem, type Tolerance } from "../../../drafting/tolerance";
+
+// ------------------------------------------------------------ the format painter
+
+/** The keys a kind's style is made of: what the painter copies. */
+export const STYLE_KEYS: Partial<Record<Annotation["type"], string[]>> = {
+  dimension: ["tolerance", "precision", "arrows", "dual", "inspection"],
+  hole: ["tolerance"],
+  note: ["height", "bold", "italic", "underline", "frame"],
+  text: ["height", "bold"],
+  balloon: ["shape", "size", "arrow", "quantity"],
+  leader: ["arrow", "spline"],
+  centerMark: ["style", "extend"],
+  centerline: ["extend"],
+  surface: ["symbol", "values", "process", "lay"],
+  datum: ["open"],
+};
+
+/** An annotation's style: its kind and the values of its style keys (absent ones as null, so painting removes them). */
+export function styleOf(a: Annotation | Record<string, unknown>): { type: string; values: Record<string, unknown> } | null {
+  const type = String((a as { type: unknown }).type);
+  const keys = STYLE_KEYS[type as Annotation["type"]];
+  if (!keys) return null;
+  const values: Record<string, unknown> = {};
+  for (const k of keys) values[k] = (a as Record<string, unknown>)[k] ?? null;
+  return { type, values };
+}
+
+/**
+ * The patch that paints a style onto an annotation (null removes a key), or
+ * why it can't: another kind, or a value the target can't take (a fit on an
+ * angle). A dimension's tolerance goes onto a hole callout's bore too.
+ */
+export function paintPatch(target: Annotation | Record<string, unknown>, style: { type: string; values: Record<string, unknown> }): Record<string, unknown> | string {
+  const type = String((target as { type: unknown }).type);
+  const keys = STYLE_KEYS[type as Annotation["type"]];
+  if (!keys) return `A ${type} has no style to paint`;
+  const cross = style.type === "dimension" && type === "hole";
+  if (style.type !== type && !cross) return `The style is a ${style.type}'s: paint it onto a ${style.type}`;
+  const patch: Record<string, unknown> = {};
+  for (const k of keys) if (k in style.values) patch[k] = style.values[k];
+  if (type === "dimension") {
+    const kind = (target as DimensionAnnotation).kind ?? "linear";
+    const t = patch.tolerance as Tolerance | null | undefined;
+    if (t && kind === "angular" && (t.kind === "fit" || t.kind === "fitWithTol" || t.kind === "fitLimits")) delete patch.tolerance;
+  }
+  return patch;
+}
+
+// ------------------------------------------------------------ favourites
+
+/** A saved dimension style: a name and the fields it sets (only those; the rest stay). */
+export interface DimFavourite {
+  name: string;
+  style: Partial<Pick<DimensionAnnotation, "tolerance" | "precision" | "typ" | "dual" | "inspection" | "arrows" | "prefix" | "suffix" | "count">>;
+  builtIn?: boolean;
+}
+
+export const BUILT_IN_FAVOURITES: DimFavourite[] = [
+  { name: "±0.1", style: { tolerance: { kind: "symmetric", plus: 0.1 } }, builtIn: true },
+  { name: "±0.05", style: { tolerance: { kind: "symmetric", plus: 0.05 } }, builtIn: true },
+  { name: "+0.1/0", style: { tolerance: { kind: "bilateral", plus: 0.1, minus: 0 } }, builtIn: true },
+  { name: "H7", style: { tolerance: { kind: "fitWithTol", fit: "H7" } }, builtIn: true },
+  { name: "h6", style: { tolerance: { kind: "fitWithTol", fit: "h6" } }, builtIn: true },
+  { name: "H7/g6", style: { tolerance: { kind: "fit", fit: "H7/g6" } }, builtIn: true },
+  { name: "Basic", style: { tolerance: { kind: "basic" } }, builtIn: true },
+  { name: "Reference", style: { tolerance: { kind: "reference" } }, builtIn: true },
+  { name: "2 decimals", style: { precision: 2 }, builtIn: true },
+];
+
+const FAV_KEY = "cocaide.dimensionFavourites.v1";
+
+/** The user's saved favourites (browser storage; empty when it can't be read). */
+export function loadFavourites(): DimFavourite[] {
+  try {
+    const raw = JSON.parse(localStorage.getItem(FAV_KEY) ?? "[]") as unknown;
+    return Array.isArray(raw) ? raw.filter((f): f is DimFavourite => !!f && typeof f.name === "string" && typeof f.style === "object") : [];
+  } catch {
+    return [];
+  }
+}
+
+export function storeFavourites(list: DimFavourite[]): void {
+  try {
+    localStorage.setItem(FAV_KEY, JSON.stringify(list.filter((f) => !f.builtIn)));
+  } catch {
+    // Storage refused (a private window): the favourite lasts this visit.
+  }
+}
+
+/** A favourite made from a dimension: its tolerance, decimals, display and text. */
+export function favouriteFrom(name: string, a: DimensionAnnotation): DimFavourite | string {
+  const n = name.trim();
+  if (!n) return "Name the favourite";
+  const style: DimFavourite["style"] = {};
+  for (const k of ["tolerance", "precision", "typ", "dual", "inspection", "arrows", "prefix", "suffix", "count"] as const) if (a[k] !== undefined) (style as Record<string, unknown>)[k] = a[k];
+  if (!Object.keys(style).length) return "This dimension has no tolerance, decimals or text to keep: set some first";
+  return { name: n, style };
+}
+
+/** The patch a favourite makes (only its own fields), or why it can't go on this dimension. */
+export function applyFavourite(a: DimensionAnnotation, f: DimFavourite): Record<string, unknown> | string {
+  const t = f.style.tolerance;
+  if (t) {
+    const p = toleranceProblem(t);
+    if (p) return `${f.name}: ${p}`;
+    if (a.kind === "angular" && (t.kind === "fit" || t.kind === "fitWithTol" || t.kind === "fitLimits")) return `${f.name} is a fit: an angle takes ± or limits, not a fit`;
+  }
+  return { ...f.style };
+}
+
+// ------------------------------------------------------------ ISO 286 classes for the fit editor
+
+/** The hole classes the fit editor lists (ISO 286-2's common ones), basic hole H first. */
+export const HOLE_CLASSES = ["H6", "H7", "H8", "H9", "H10", "H11", "G6", "G7", "F7", "F8", "E8", "E9", "D9", "D10", "C11", "JS6", "JS7", "K6", "K7", "M6", "M7", "N6", "N7", "P6", "P7", "R7", "S7", "U7"];
+/** The shaft classes, basic shaft h first. */
+export const SHAFT_CLASSES = ["h5", "h6", "h7", "h8", "h9", "h11", "g5", "g6", "f6", "f7", "e7", "e8", "d9", "d10", "c11", "js5", "js6", "k5", "k6", "m5", "m6", "n5", "n6", "p5", "p6", "r6", "s6", "u6"];
+/** The fits offered as one click: ISO 286-2's preferred hole-basis fits. */
+export const COMMON_FITS = ["H7/g6", "H7/h6", "H7/k6", "H7/m6", "H7/n6", "H7/p6", "H7/s6", "H8/f7", "H9/d9", "H11/c11"];
+
+export interface ClassChoice {
+  value: string;
+  /** "H7  +0.021 / 0" at the size. */
+  label: string;
+  upper: number;
+  lower: number;
+}
+
+/** A side's classes with their deviations at this size (the ones ISO 286 has there). */
+export function classChoices(size: number, side: "hole" | "shaft"): ClassChoice[] {
+  const out: ClassChoice[] = [];
+  for (const c of side === "hole" ? HOLE_CLASSES : SHAFT_CLASSES) {
+    const d = classDeviations(size, c);
+    if (!d) continue;
+    out.push({ value: c, label: `${c}  ${deviationText(d.upper, 3)} / ${deviationText(d.lower, 3)}`, upper: d.upper, lower: d.lower });
+  }
+  return out;
+}
+
+export interface FitSummary {
+  /** One line each: the hole's limits, the shaft's, and the fit. */
+  lines: string[];
+  type?: FitType;
+}
+
+/** What a fit code means at a size, in words and numbers: "Hole Ø25 H7: 25.000 – 25.021". */
+export function fitSummary(size: number, code: string, symbol = ""): FitSummary | null {
+  const f = parseFit(code);
+  if (!f) return null;
+  const lines: string[] = [];
+  const lim = (d: { upper: number; lower: number }) => `${numberText(size + d.lower, 3)} – ${numberText(size + d.upper, 3)}`;
+  for (const side of ["hole", "shaft"] as const) {
+    const c = f[side];
+    if (!c) continue;
+    const d = classDeviations(size, c);
+    if (!d) return { lines: [`${c.letter}${c.grade} is not in ISO 286 at ${numberText(size)} mm`] };
+    lines.push(`${side === "hole" ? "Hole" : "Shaft"} ${symbol}${numberText(size)} ${c.letter}${c.grade}: ${lim(d)} (${deviationText(d.upper, 3)} / ${deviationText(d.lower, 3)})`);
+  }
+  const pair = f.hole && f.shaft ? fitOf(size, f) : null;
+  if (pair) {
+    const what = (x: number) => (x >= 0 ? `clearance ${numberText(x, 3)}` : `interference ${numberText(-x, 3)}`);
+    lines.push(`${pair.type[0].toUpperCase()}${pair.type.slice(1)} fit: ${what(pair.minClearance)} to ${what(pair.maxClearance)}`);
+    return { lines, type: pair.type };
+  }
+  return { lines };
+}
diff --git a/src/ui/drawing/tools/symbolTools.tsx b/src/ui/drawing/tools/symbolTools.tsx
new file mode 100644
index 0000000..fc5ef0c
--- /dev/null
+++ b/src/ui/drawing/tools/symbolTools.tsx
@@ -0,0 +1,941 @@
+// The symbol tools (Phase Q wave Q3A): the GD&T builder (characteristic
+// palette, zone Ø, value, material and zone modifiers, up to three datums
+// from the ones on the drawing with their modifiers, a second or composite
+// row, a live preview of the frame and the rule checks as you build it),
+// attached to a feature, a dimension or a leader point; the datum feature
+// symbol (its letter counts up) and datum targets; the surface texture
+// symbol; the weld symbol builder (arrow and other side, sizes, intermittent
+// length and pitch, contour, finish, all around, field weld, tail; ISO or AWS
+// preview; filled from a weld of the weld table).
+
+import type { ReactNode } from "react";
+import type { Annotation, DatumAnnotation, GdtAnnotation, GdtDatumRef, GdtModifier, GdtRow, SurfaceAnnotation, Vec2, Weld, WeldAnnotation, WeldSymbolSide } from "../../../doc/types";
+import { LAY_SYMBOLS, SURFACE_SYMBOLS, WELD_CONTOURS, WELD_SYMBOLS } from "../../../doc/types";
+import { validateDocument } from "../../../doc/validate";
+import { CHARACTERISTIC_INFO, datumFromPick, datumLabels, draftStyle, framePrims, gdtFromPick, gdtProblems, sidesOfWeld, surfaceFromPick, surfacePrims } from "../../../drafting/annotate";
+import { CHARACTERISTIC_CHAR, GDT_CHARACTERISTICS, type GdtCharacteristic } from "../../../drafting/symbols/glyphs";
+import type { SnapKind, SnapTarget } from "../snap";
+import { keep } from "./editing";
+import { annotationKind, registerAnnotationKind, type KindPanelProps } from "./kinds";
+import { previewAnnotation } from "./preview";
+import { registerDrawingTool } from "./registry";
+import { ToolSession, noViews } from "./toolSession";
+import type { DrawingToolCtx, OverlayShape, SheetPointer } from "./types";
+import { Commit, numberOf, PrimThumb, Row, Segmented } from "./ui";
+
+const FEATURE: SnapKind[] = ["edge", "circle", "arc", "vertex", "midpoint", "centre", "quadrant"];
+const LETTERS = "ABCDEFGHJKLMNPRSTUVWXYZ";
+
+/** Every datum letter on the drawing (all sheets). */
+function drawingDatums(c: { drawing: { sheets: { annotations: Annotation[] }[] } }): string[] {
+  return [...datumLabels(c.drawing.sheets.flatMap((s) => s.annotations))].sort();
+}
+
+/** The next free datum letter, past the ones given too. */
+export function nextLetter(used: Iterable<string>): string {
+  const u = new Set(used);
+  for (const l of LETTERS) if (!u.has(l)) return l;
+  return "AA";
+}
+
+/** A pick of a feature or a dimension (the annotation under the pointer when it is a dimension). */
+type Target = { ref?: string; dimension?: string; view: string; size?: boolean; at: Vec2 };
+
+function targetAt(c: DrawingToolCtx, p: SheetPointer, dimensions = true): Target | null {
+  // Geometry under the pointer first (a dimension's extension lines run over the part); else a dimension.
+  if (dimensions && !p.snap && p.hit?.kind === "annotation") {
+    const a = c.sheetDoc.annotations.find((x) => x.id === p.hit!.id);
+    if (a?.type === "dimension") return { dimension: a.id, view: a.view, size: true, at: p.raw };
+  }
+  const s = p.snap;
+  if (!s) return null;
+  return { ref: s.ref, view: s.view, size: s.kind === "circle" || s.kind === "arc" || s.kind === "centre" ? true : s.kind === "edge" ? false : undefined, at: s.at };
+}
