+    expect(said(s, "d2").hidden).toBe(true);
+    expect(s.prims.some((p) => p.owner === "d2")).toBe(false);
+    expect(apply(d.doc, { type: "editAnnotation", id: "d2", patch: { hidden: "yes" } })).toMatchObject({ ok: false });
+  });
+});
