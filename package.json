{
  "name": "cocaide",
  "private": true,
  "version": "0.1.0",
  "description": "Browser parametric CAD: one JSON feature document, rebuilt by OpenCascade in the tab.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cocaide": "tsx scripts/cocaide.ts",
    "verify:freecad": "tsx scripts/verify-freecad.ts",
    "test:e2e": "playwright test",
    "mcp": "tsx src/mcp/server.ts",
    "replay": "tsx scripts/replay.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "replicad-opencascadejs": "1.1.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
